generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id             String          @id
  name           String
  createdAt      DateTime        @default(now()) @map("created_at")
  staffMembers   StaffMember[]
  teacherInvites TeacherInvite[]

  @@unique([name])
  @@map("schools")
}

model StaffMember {
  id                String   @id
  schoolId          String   @map("school_id")
  workEmail         String   @map("work_email")
  passwordHash      String   @map("password_hash")
  role              String
  status            String
  failedSignInCount Int      @default(0) @map("failed_sign_in_count")
  lockedUntil       DateTime? @map("locked_until")
  createdAt         DateTime  @default(now()) @map("created_at")
  school            School    @relation(fields: [schoolId], references: [id])
  sessions          Session[]

  @@unique([workEmail])
  @@index([schoolId])
  @@map("staff_members")
}

model Session {
  id            String      @id
  staffMemberId String      @map("staff_member_id")
  tokenHash     String      @map("token_hash")
  expiresAt     DateTime    @map("expires_at")
  revokedAt     DateTime?   @map("revoked_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([staffMemberId])
  @@map("sessions")
}

model TeacherInvite {
  id        String   @id
  schoolId  String   @map("school_id")
  workEmail String   @map("work_email")
  tokenHash String   @map("token_hash")
  status    String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  school    School   @relation(fields: [schoolId], references: [id])

  @@unique([tokenHash])
  @@index([schoolId])
  @@index([schoolId, workEmail, status])
  @@map("teacher_invites")
}
